$TTL 3600
;TTL predeterminado de los registros: 1 hora

@       IN      SOA     ns1.empresa.local. root.empresa.local. (
                        2026090408 ; Serial
                        3600       ; Refresh: el esclavo comprueba cambios cada 1 hora
                        900        ; Retry: reintenta después de 15 minutos si falla el refresh.
                        1209600    ; Expire: la zona deja de ser válida después de 14 días sin poder contactar al maestro.
                        3600       ; Minimum TTL: 1 hora
)

@       IN      NS      ns1.empresa.local.
@       IN      NS      ns2.empresa.local.
ns1     IN      A       192.168.50.2
ns2     IN      A       192.168.50.3
maestro IN      A       192.168.50.2
esclavo IN      A       192.168.50.3
www     IN      A       192.168.50.2
mail    IN      A       192.168.50.2
parcial IN      A       192.168.50.2
ns1     IN      AAAA    fd50:1234:5678:1::2
ns2     IN      AAAA    fd50:1234:5678:1::3
www     IN      AAAA    fd50:1234:5678:1::2
mail    IN      AAAA    fd50:1234:5678:1::2
ftp     IN      CNAME   www
@       IN      MX      10 mail.empresa.local.
prueba6 IN      A       192.168.50.25
